# /opt/rap/backup.env on the VM (root:root, chmod 600). Names only; values from Infisical.
# Database: the local postgres container, reached over the compose network.
SOURCE_DATABASE_URL=postgresql://rap:<VM_POSTGRES_PASSWORD>@postgres:5432/remote_ai_platform
PG_IMAGE=postgres:17
PG_DOCKER_NETWORK=rap-prod_internal
PYTHON=/opt/rap/venv/bin/python
OUT_DIR=/var/backups/rap
LOCAL_KEEP=3
BACKUP_PASSPHRASE=            # prod:/ BACKUP_PASSPHRASE
# Object storage being backed up (prod:/render-api MINIO_*)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKETS=
# Where archives go (prod:/automation OCI_S3_*)
ARCHIVE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
ARCHIVE_S3_REGION=eu-frankfurt-1
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_BUCKET=rap-prod-backups
ARCHIVE_PREFIX=db/
ARCHIVE_KEEP=14
# Run evidence in the staff console (prod:/automation BACKUP_REPORT_TOKEN).
# BACKUP_ENVIRONMENT=rehearsal until the cut-over, then production.
BACKUP_REPORT_URL=https://api.remoteaiplatform.com
BACKUP_REPORT_TOKEN=
BACKUP_ENVIRONMENT=rehearsal
