{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "remote-ai-platform",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding, the service name must match "name" above
      // -- see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "remote-ai-platform"
    }
  ],
  // No r2_buckets binding for now -- R2 needs a one-time manual "enable" in
  // the Cloudflare dashboard first (Cloudflare requires this even for the
  // free tier). Add it back, matching open-next.config.ts's incrementalCache
  // override, once that's done and ISR caching is actually needed.
  "images": {
    "binding": "IMAGES"
  }
}
