# NEXT_PUBLIC_* variables are baked into the build at build time, not read
# at runtime -- must be set before `npm run cf:build` / `npm run cf:deploy`,
# not just on the Cloudflare Worker's runtime environment.

# Base URL of the FastAPI backend, WITHOUT a trailing /api/v1 (the axios
# client in src/lib/api.ts appends that itself). Defaults to
# http://localhost:8000 if unset, which is only correct for local dev.
NEXT_PUBLIC_API_URL=https://remote-ai-platform-api.onrender.com

# Supabase Auth. The publishable key is safe to expose client-side by
# design (same trust level as any other public API key) -- it only grants
# what Supabase's Row Level Security policies allow.
# Redacted: replace with your own project's values. Even though the
# publishable key is safe to expose client-side by design, an example file
# should not carry a real project's URL/key -- use your own Supabase project's.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
