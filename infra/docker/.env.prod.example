# Names only. Values come from Infisical (prod:/render-api) — never commit a filled copy.
APP_ENV=production
DEBUG=false
PORT=8000
WEB_CONCURRENCY=2
DATABASE_URL=
SUPABASE_URL=
CORS_ORIGINS=https://remoteaiplatform.com,https://www.remoteaiplatform.com,https://admin.remoteaiplatform.com
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
# Cloudflare R2 (STORAGE_PROVIDER=r2). Keep STORAGE_LEGACY_FALLBACK=true until ops/storage/migrate_objects.py --verify passes.
STORAGE_PROVIDER=s3
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_LEGACY_FALLBACK=false
STORAGE_LEGACY_BUCKETS=
FILES_BUCKET=
MINIO_BUCKET_DELIVERABLES=
MINIO_BUCKET_RESUMES=
MINIO_BUCKET_ASSETS=
AI_PROVIDER=auto
GROQ_API_KEY=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENTRY_DSN=
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
JOB_SYNC_TOKEN=
GOOGLE_INDEXING_CREDENTIALS_B64=
JOOBLE_API_KEY=
# Compose-only
RAP_IMAGE=ghcr.io/gokul-227/remote-ai-platform-api:latest
API_PUBLIC_HOST=api.remoteaiplatform.com
