{
  "name": "remote-ai-platform",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "db:migrate": "cd apps/api && alembic upgrade head"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "supabase": "^2.122.1",
    "turbo": "^2.11.10"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all",
    "printWidth": 120
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "@sentry/cli@2.58.6": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260903.1": true
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "axios": {
      "follow-redirects": "1.16.2"
    },
    "ajv": {
      "fast-uri": "3.1.9"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "@sentry/bundler-plugins": {
      "glob": "14.0.2"
    },
    "glob@>=9 <14.0.2": "14.0.3",
    "minimatch@>=7 <11.0.1": "11.0.4",
    "@grpc/grpc-js": "1.13.7"
  }
}
