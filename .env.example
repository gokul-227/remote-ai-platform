# WorkMesh AI — Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to source control

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=WorkMesh AI
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workmesh
POSTGRES_USER=workmesh
POSTGRES_PASSWORD=workmesh_dev_password
DATABASE_URL=postgresql+asyncpg://workmesh:workmesh_dev_password@localhost:5432/workmesh

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_password
MINIO_BUCKET_RESUMES=workmesh-resumes
MINIO_BUCKET_ASSETS=workmesh-assets
MINIO_SECURE=false

# ─── Keycloak (Authentication) ────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=workmesh
KEYCLOAK_CLIENT_ID=workmesh-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# ─── JWT (Internal tokens, used alongside Keycloak) ──────────────────────────
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI / LiteLLM ─────────────────────────────────────────────────────────────
# Local Ollama (default for development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=qwen2.5
OLLAMA_MODEL_CODER=qwen2.5-coder
OLLAMA_MODEL_REASONING=deepseek-coder

# Production AI provider (Groq free tier — switch via LiteLLM)
# GROQ_API_KEY=your_groq_api_key_here
# AI_PROVIDER=groq/llama-3.1-70b-versatile

# OpenAI-compatible (optional override)
# OPENAI_API_KEY=your_openai_api_key_here

AI_PROVIDER=ollama/qwen2.5
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# ─── Job Aggregator APIs ──────────────────────────────────────────────────────
# All sources below are free/no-auth unless noted
REMOTEOK_API_URL=https://remoteok.com/api
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
USAJOBS_API_URL=https://data.usajobs.gov/api/search
USAJOBS_USER_AGENT=WorkMeshAI/0.1 (your-email@example.com)
USAJOBS_AUTH_KEY=  # Optional: get free key at usajobs.gov/developer
THEMUSE_API_URL=https://www.themuse.com/api/public/jobs

# Aggregator schedule (cron expression)
JOB_SYNC_SCHEDULE=0 */6 * * *  # Every 6 hours

# ─── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin_dev_password
LOKI_PORT=3100

# ─── Traefik ──────────────────────────────────────────────────────────────────
TRAEFIK_DASHBOARD_PORT=8090
ACME_EMAIL=your-email@example.com  # For Let's Encrypt in production

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AI_RESUME_PARSING=true
FEATURE_AI_MATCHING=true
FEATURE_JOB_AGGREGATOR=true
FEATURE_KEYCLOAK_AUTH=true
