# Remote AI Platform — Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to source control

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Remote AI Platform
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Read by the Next.js frontend (apps/web) — bare host, no /api/v1 suffix (the frontend appends it itself)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to false in production to prevent seeding demo accounts
SEED_DEMO_DATA=true
# Rate limiting configuration (requests per window)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=remote_ai_platform
POSTGRES_USER=remote_ai_platform
POSTGRES_PASSWORD=replace_with_database_password
DATABASE_URL=postgresql+asyncpg://remote_ai_platform:remote_ai_platform_dev_password@localhost:5432/remote_ai_platform

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET_RESUMES=remote-ai-platform-resumes
MINIO_BUCKET_ASSETS=remote-ai-platform-assets
MINIO_SECURE=false

# ─── Keycloak (Authentication) ────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=remote-ai-platform
KEYCLOAK_CLIENT_ID=remote-ai-platform-api
KEYCLOAK_WEB_CLIENT_ID=remote-ai-platform-web
KEYCLOAK_CLIENT_SECRET=replace_with_keycloak_client_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_keycloak_admin_password

# ─── JWT (Internal tokens, used alongside Keycloak) ──────────────────────────
JWT_SECRET_KEY=replace_with_long_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI / LiteLLM ─────────────────────────────────────────────────────────────
# AI provider selection. Use `groq` with a Groq key, or `ollama` locally.
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=replace_with_ai_provider_key
LITELLM_BASE_URL=
AI_FALLBACK_PROVIDERS=ollama/qwen2.5

# Local Ollama fallback/development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=qwen2.5
OLLAMA_MODEL_CODER=qwen2.5-coder
OLLAMA_MODEL_REASONING=deepseek-coder

# Optional provider-specific key; AI_API_KEY is preferred.
# GROQ_API_KEY=replace_with_groq_api_key

# OpenAI-compatible provider (select `openai` or a compatible model name).
# OPENAI_API_KEY=replace_with_openai_api_key

AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# ─── Job Aggregator APIs ──────────────────────────────────────────────────────
# All sources below are free/no-auth unless noted
REMOTEOK_API_URL=https://remoteok.com/api
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
USAJOBS_API_URL=https://data.usajobs.gov/api/search
USAJOBS_USER_AGENT=RemoteAIPlatform/0.1 (your-email@example.com)
USAJOBS_AUTH_KEY=  # Optional: get free key at usajobs.gov/developer
THEMUSE_API_URL=https://www.themuse.com/api/public/jobs

# Aggregator schedule (cron expression)
JOB_SYNC_SCHEDULE=0 */6 * * *  # Every 6 hours


# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AI_RESUME_PARSING=true
FEATURE_AI_MATCHING=true
FEATURE_JOB_AGGREGATOR=true
FEATURE_KEYCLOAK_AUTH=true
