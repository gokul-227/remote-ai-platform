# Remote AI Platform — Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to source control

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Remote AI Platform
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Read by the Next.js frontend (apps/web) — bare host, no /api/v1 suffix (the frontend appends it itself)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Rate limiting configuration (requests per window)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=remote_ai_platform
POSTGRES_USER=remote_ai_platform
POSTGRES_PASSWORD=replace_with_database_password
DATABASE_URL=postgresql+asyncpg://remote_ai_platform:remote_ai_platform_dev_password@localhost:5432/remote_ai_platform

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET_RESUMES=remote-ai-platform-resumes
MINIO_BUCKET_ASSETS=remote-ai-platform-assets
MINIO_SECURE=false

# ─── Supabase Auth (the only sign-in path) ───────────────────────────────────
# Use the DEV Supabase project locally. The API verifies Supabase-issued access
# tokens against this project's JWKS; the web app signs in against it.
SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_dev_publishable_key

# ─── AI / LiteLLM ─────────────────────────────────────────────────────────────
# "auto" tries the free-tier chain below, skipping providers without a key.
AI_PROVIDER=auto
AI_FREE_TIER_CHAIN=groq/llama-3.3-70b-versatile,gemini/gemini-2.0-flash,cerebras/llama-3.3-70b,openrouter/meta-llama/llama-3.3-70b-instruct:free,mistral/mistral-small-latest
# Free-tier keys (set any subset):
# GROQ_API_KEY=        https://console.groq.com/keys
# GEMINI_API_KEY=      https://aistudio.google.com/app/apikey
# CEREBRAS_API_KEY=    https://cloud.cerebras.ai
# OPENROUTER_API_KEY=  https://openrouter.ai/keys
# MISTRAL_API_KEY=     https://console.mistral.ai/api-keys
AI_TOTAL_BUDGET_SECONDS=45
AI_FREE_MONTHLY_TOKENS=20000
AI_PRO_MONTHLY_TOKENS=50000
AI_GLOBAL_DAILY_TOKENS=300000

# Explicit single-provider setup (AI_PROVIDER=groq|ollama|...) still works:
AI_MODEL=llama-3.1-8b-instant
AI_FALLBACK_PROVIDERS=ollama/qwen2.5
# AI_API_KEY=         generic key, only used when no provider-specific key is set
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=qwen2.5
OLLAMA_MODEL_CODER=qwen2.5-coder
OLLAMA_MODEL_REASONING=deepseek-coder
# OPENAI_API_KEY=replace_with_openai_api_key
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# ─── Job Aggregator APIs ──────────────────────────────────────────────────────
# All sources below are free/no-auth unless noted
REMOTEOK_API_URL=https://remoteok.com/api
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
USAJOBS_API_URL=https://data.usajobs.gov/api/search
USAJOBS_USER_AGENT=RemoteAIPlatform/0.1 (support@remoteaiplatform.com)
USAJOBS_AUTH_KEY=  # Optional: get free key at usajobs.gov/developer
THEMUSE_API_URL=https://www.themuse.com/api/public/jobs

# Aggregator schedule (cron expression)
JOB_SYNC_SCHEDULE=0 */6 * * *  # Every 6 hours


# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_AI_RESUME_PARSING=true
FEATURE_AI_MATCHING=true
FEATURE_JOB_AGGREGATOR=true
